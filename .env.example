# Copiar a .env y completar con los valores reales.
# El .env está en .gitignore y no se sube al repositorio.

# Clave de la API de Anthropic
ANTHROPIC_API_KEY=

# Identificadores del agente en la plataforma de Anthropic
AGENT_ID=
ENVIRONMENT_ID=

# ID del calendario de Google donde se crean los turnos
CALENDAR_ID=

# Clave de la API de Kapso (Project settings > API keys): para bajar los audios del dueño
KAPSO_API_KEY=

# Secreto del webhook del número en Kapso: para verificar que los mensajes vienen de Kapso
KAPSO_WEBHOOK_SECRET=
